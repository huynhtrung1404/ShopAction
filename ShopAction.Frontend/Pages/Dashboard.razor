@page "/"

@using ShopAction.Frontend.Components.Common
@using ShopAction.Frontend.Models;
@using ShopAction.Frontend.Services.Interfaces;

@inject IDashboardService DashboardService

<PageTitle>Dashboard | Nexus</PageTitle>

@if (_isLoading)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-primary"></div>
    </div>
}
else if (_dashboard is null)
{
    <EmptyState Icon="bi bi-exclamation-circle" Title="Unable to load dashboard" Description="Please try again later." />
}
else
{
    <PageHeader Title="Dashboard" Description="Welcome back! Here's your identity management overview.">

        <Actions>
            <button class="btn btn-outline-secondary" @onclick="RefreshAsync" disabled="@_isLoading">

                <i class="bi bi-arrow-clockwise me-2"></i>
                Refresh

            </button>
        </Actions>

    </PageHeader>

    <!-- Statistics -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-3">
            <StatCard Title="Total Users" Value="@_dashboard.TotalUsers.ToString("N0")" Icon="bi bi-people"
                      IconColor="icon-primary" Description="Registered accounts" />
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <StatCard Title="Active Users" Value="@_dashboard.ActiveUsers.ToString("N0")" Icon="bi bi-person-check"
                      IconColor="icon-success" Description="Currently active" />
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <StatCard Title="Roles" Value="@_dashboard.TotalRoles.ToString("N0")" Icon="bi bi-person-badge"
                      IconColor="icon-warning" Description="Configured roles" />
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <StatCard Title="Permissions" Value="@_dashboard.TotalPermissions.ToString("N0")" Icon="bi bi-key"
                      IconColor="icon-info" Description="Available permissions" />
        </div>

    </div>

    <!-- Secondary statistics -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-md-6">
            <div class="card dashboard-summary-card">
                <div class="card-body d-flex align-items-center gap-3">

                    <div class="stat-icon icon-purple">
                        <i class="bi bi-shield-check"></i>
                    </div>

                    <div>
                        <div class="stat-title">Authorization Policies</div>

                        <div class="fs-4 fw-bold">
                            @_dashboard.TotalPolicies
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="card dashboard-summary-card">
                <div class="card-body d-flex align-items-center gap-3">

                    <div class="stat-icon icon-success">
                        <i class="bi bi-activity"></i>
                    </div>

                    <div>
                        <div class="stat-title">User Activity Rate</div>

                        <div class="fs-4 fw-bold">
                            @GetActivePercentage()%
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>

    <!-- Recent Activities -->
    <div class="card dashboard-activity-card">

        <div class="card-header bg-white border-0 pt-4 px-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="fw-bold mb-1">
                        Recent Activities
                    </h5>

                    <p class="text-secondary small mb-0">
                        Latest system activities
                    </p>
                </div>

                <button class="btn btn-sm btn-outline-primary" disabled>

                    View all
                </button>

            </div>

        </div>

        <div class="card-body px-4">

            @if (_dashboard.Activities.Count == 0)
            {
                <EmptyState Title="No recent activities" Description="Activity records will appear here." />
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle dashboard-table">

                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Action</th>
                                <th>Resource</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var activity in _dashboard.Activities)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-medium">
                                            @activity.UserName
                                        </div>
                                    </td>

                                    <td>@activity.Action</td>

                                    <td>@activity.Resource</td>

                                    <td class="text-secondary">
                                        @activity.CreatedAt.ToString("dd MMM yyyy HH:mm")
                                    </td>

                                    <td>
                                        @if (activity.Status == "Success")
                                        {
                                            <span class="badge text-bg-success">
                                                Success
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-danger">
                                                Failed
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>
}

@code {
    private DashboardViewModel? _dashboard;

    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        _isLoading = true;

        try
        {
            _dashboard = await DashboardService.GetDashboardAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private decimal GetActivePercentage()
    {
        if (_dashboard is null || _dashboard.TotalUsers == 0)
        {
            return 0;
        }

        return Math.Round(
            (decimal)_dashboard.ActiveUsers /
            _dashboard.TotalUsers * 100,
            1);
    }
}