<header class="app-topbar">

    <div class="d-flex align-items-center gap-3">

        <!-- Mobile Menu -->
        <button class="btn btn-light d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar"
                aria-controls="mobileSidebar" aria-label="Open navigation">

            <i class="bi bi-list fs-5"></i>

        </button>

        <div class="topbar-breadcrumb">
            <span class="text-secondary">Workspace</span>
            <i class="bi bi-chevron-right"></i>
            <span class="fw-semibold">Administration</span>
        </div>

    </div>

    <div class="d-flex align-items-center gap-2">

        <!-- Search -->
        <button class="btn btn-light topbar-icon-button" title="Search">

            <i class="bi bi-search"></i>

        </button>

        <!-- Notifications -->
        <button class="btn btn-light topbar-icon-button position-relative" title="Notifications">

            <i class="bi bi-bell"></i>

            <span class="notification-dot"></span>

        </button>

        <div class="topbar-divider"></div>

        <!-- User Menu -->
        <div class="dropdown">

            <button class="btn user-menu-button dropdown-toggle" type="button" data-bs-toggle="dropdown"
                    aria-expanded="false">

                <div class="user-avatar">
                    AD
                </div>

                <div class="user-info d-none d-sm-block text-start">

                    <div class="user-name">
                        Administrator
                    </div>

                    <div class="user-role">
                        Super Admin
                    </div>

                </div>

            </button>

            <ul class="dropdown-menu dropdown-menu-end shadow-sm">

                <li>
                    <h6 class="dropdown-header">
                        My Account
                    </h6>
                </li>

                <li>
                    <a class="dropdown-item" href="/settings">
                        <i class="bi bi-person me-2"></i>
                        Profile
                    </a>
                </li>

                <li>
                    <a class="dropdown-item" href="/settings">
                        <i class="bi bi-gear me-2"></i>
                        Settings
                    </a>
                </li>

                <li>
                    <hr class="dropdown-divider" />
                </li>

                <li>
                    <button class="dropdown-item text-danger" type="button" disabled>
                        <i class="bi bi-box-arrow-right me-2"></i>
                        Logout (Not available)
                    </button>
                </li>

            </ul>

        </div>

    </div>

</header>